# Copy this file to .env and fill in real values. Do NOT commit .env.
# ==========================================================================

# --- LLM (OpenAI-compatible endpoint) ---
# The gateway speaks the OpenAI API; use the OpenAI SDK with this base_url.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.pinkyne.com/v1

# Model tier — planner uses a strong model, subagents/tools use a cheap model.
# See research_agent/core/config.py for the meaning of each variable.
PLANNER_MODEL=gpt-4o
WORKER_MODEL=gpt-4o
VERIFIER_MODEL=gpt-4o
SYNTH_MODEL=gpt-4o

# --- Guardrail: hard limits per request (prevent runaway cost during testing) ---
MAX_LLM_CALLS=25
MAX_TOOL_CALLS=40
MAX_TOKENS_BUDGET=200000
MAX_USD_BUDGET=1.50
REQUEST_TIMEOUT_SEC=180
MAX_REPLAN=3
# Extra verifier round that tries to refute the strongest claims (costs more).
ADVERSARIAL_VERIFY=false

# --- Cost ---
# Optional override of the built-in price table (core/config.py), so gateway
# model prices can be set without code changes. Format:
# model:input_price:output_price (USD per 1M tokens), comma-separated.
# MODEL_PRICING=gpt-4o:2.5:10.0

# --- Web search tool ---
# TAVILY_API_KEY=
# SERPER_API_KEY=

# --- Tools ---
# Local folder the document tool searches for INTERNAL_RAG sources
# (.md/.txt/.json/.csv/... files). PDF support needs a parsing library later.
DOCUMENT_ROOT=./data/documents

# --- Memory / Vector DB ---
# The vector store is pure-Python (JSON at CHROMA_PERSIST_DIR/memory.json); no DB
# to install. Embeddings use EMBEDDING_MODEL via the gateway, with an offline
# hashing fallback if the endpoint has no /embeddings.
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small
# USE_MEMORY=true toggles recall + internal RAG. MEMORY_RECALL_THRESHOLD is the
# min cosine similarity to reuse a past report (high = only near-identical Qs).
USE_MEMORY=true
MEMORY_RECALL_THRESHOLD=0.92

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
